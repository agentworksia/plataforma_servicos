# =============================================================================
# Copie para .env (local) e configure as MESMAS variáveis no painel da Vercel
# (Project > Settings > Environment Variables), em Production e Preview.
# NUNCA commite o .env — segredos ficam só aqui e na Vercel.
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"          # em prod: a URL pública da Vercel

# --- Banco (Supabase Postgres) ---------------------------------------------
# Projeto: https://piwtziklxcdbzajgitlw.supabase.co
# Pegue as strings prontas em: Supabase > botão "Connect" (topo) > ORMs / Prisma.
#
# DATABASE_URL  -> "Transaction pooler" (porta 6543) para o runtime serverless
# DIRECT_URL    -> "Session pooler" (porta 5432) para as migrations (prisma migrate)
# Troque [PASSWORD] pela senha do banco e [REGION] pela região do seu projeto.
# (o tamanho do pool é controlado no código, em src/lib/db.ts — não via URL)
DATABASE_URL="postgresql://postgres.piwtziklxcdbzajgitlw:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.piwtziklxcdbzajgitlw:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# --- Auth.js (NextAuth v5) ------------------------------------------------
# Gere: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-aleatorio"
AUTH_URL="http://localhost:3000"                     # em prod: a URL pública da Vercel

# --- Supabase (Storage: foto de perfil + documentos) ---------------------
# Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://piwtziklxcdbzajgitlw.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon public key>"
SUPABASE_SERVICE_ROLE_KEY="<service_role key — secreta, só no servidor>"
SUPABASE_BUCKET_DOCUMENTOS="documentos"
SUPABASE_BUCKET_PERFIL="perfil"

# --- E-mail transacional (Resend) --------------------------------------
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="Plataforma <nao-responda@seudominio.com.br>"

# --- Pagamento --------------------------------------------------------------
PAYMENT_PROVIDER="fake"
