# =============================================================================
# Copie para .env e preencha. NUNCA commite o .env (já está no .gitignore).
# Na Vercel, configure estas variáveis no painel do projeto antes do 1º deploy.
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Banco (Supabase Postgres) ---------------------------------------------
# Use a "Connection string" do Supabase (Project Settings > Database).
# Runtime usa o pooler (porta 6543, pgbouncer). Migrations usam a conexão direta (porta 5432).
DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Auth.js (NextAuth v5) ------------------------------------------------
# Gere um segredo: `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET="troque-por-um-segredo-aleatorio"
# Em produção, defina para a URL pública (ex.: https://seuapp.vercel.app)
AUTH_URL="http://localhost:3000"

# --- Supabase (Storage: foto de perfil + documentos) ---------------------
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# Service role: só no servidor. Nunca exponha no client.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_BUCKET_DOCUMENTOS="documentos"
SUPABASE_BUCKET_PERFIL="perfil"

# --- E-mail transacional (Resend) --------------------------------------
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="Plataforma <nao-responda@seudominio.com.br>"

# --- Pagamento --------------------------------------------------------------
# "fake" no MVP: cobranças/repasses são simulados. Trocar para o provider real depois.
PAYMENT_PROVIDER="fake"
